{
  "name": "ponte-tecnica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vocabulário técnico por profissão, do alemão para o português do Brasil.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run typecheck && npm run lint && npm run format:check && npm test",
    "export-terms": "tsx scripts/export-terms.ts",
    "images:fetch": "tsx scripts/images/fetch.ts",
    "images:apply": "tsx scripts/images/apply.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
